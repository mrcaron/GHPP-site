---
import Base from '../layouts/Base.astro';
import { SITE, LOCATION, WELCOME_SLUG } from '../config';

// Only ever generates ONE page, at the unguessable WELCOME_SLUG path — every
// other single-segment URL (e.g. /foo) has no matching file and 404s.
export function getStaticPaths() {
  return [{ params: { welcomeSlug: WELCOME_SLUG } }];
}

const w = LOCATION.welcome;
---

<Base title="Welcome — your visit details" noindex={true}>
  <section class="section">
    <div class="container measure">
      <p class="eyebrow">You're booked in</p>
      <h1>Welcome to The Greenhouse</h1>
      <p class="lede">
        Here's what you need to know about the prayer room. This page is
        private — please don't share the link.
      </p>

      <div class="notice">
        <strong>⚠️ Temporary change:</strong> The garage keypad is out of
        order, so it's been switched off — the back door is left <strong>unlocked</strong> instead.
        See the steps below for how to lock up while you're inside.
      </div>
    </div>
  </section>

  <section class="section section--paper2">
    <div class="container">
      <div class="welcome-loc">
        <div>
          <p class="eyebrow">The address</p>
          <h2>Where to go</h2>
          <p class="address">
            {w.addressLine}<br />
            {w.cityLine}
          </p>
          <p>
            Head to the <strong>back door of the detached garage</strong>
            (it's left unlocked right now — see below), and climb the stairs
            to the loft.
          </p>
          <div class="dir-buttons">
            <a href={w.googleDirections} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
              Directions in Google Maps
            </a>
            <a href={w.appleDirections} class="btn btn--teal" target="_blank" rel="noopener noreferrer">
              Directions in Apple Maps
            </a>
          </div>
        </div>
        <div class="map-embed">
          <iframe
            title={`Map to The Greenhouse in ${SITE.city}`}
            src={w.exactMapEmbed}
            loading="lazy"
            referrerpolicy="no-referrer"
            allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section measure container">
    <p class="eyebrow">Getting in</p>
    <h2>What to know before you arrive</h2>
    <ol class="steps">
      <li>
        You can park on the side of the garage next to the garden, or on the
        street — just please don't block the garage door.
      </li>
      <li>
        The garage's keypad is currently out of order, so it's been turned
        off — the back door is left unlocked. Just let yourself in, no code
        needed.
      </li>
      <li>
        Just inside the door, you'll find two labeled <strong>keys</strong> on
        the shelf by the stairs (pictured below) — "Main" and "Prayer Room."
        Lock the main door from inside using the deadbolt latch. Take both
        keys with you as you head up to the room, so you're secure the whole
        time. If they're not there (the person before you may still have
        them), text {w.phoneHref ? <a href={w.phoneHref}>{w.phoneDisplay}</a> : w.phoneDisplay} and
        we'll help sort it out — please don't leave the door unattended and
        unlocked while you go looking for them.
      </li>
      <li>
        You might hear us in the garage below — pulling in the car or
        grabbing tools for outside — we'll do our best to keep it quiet and
        honor your time with the Father.
      </li>
      <li>Don't look behind the curtain — we're still cleaning up from the marathon construction push. 😂</li>
      <li>
        The door to the room is really sticky from the humidity — give it a
        good push to get in, and don't be shy about slamming it closed behind
        you. Lock it from the inside using the latch on the door handle, keep the keys with you — and don't worry about
        anyone coming in. Greenhouse staff maintain a copy of the keys in case of emergency.
      </li>
      <li>
        Those stairs are more like a ladder than stairs — climb them slowly
        and carefully, both up and back down, to stay safe.
      </li>
      <li>
        Text {w.phoneHref ? <a href={w.phoneHref}>{w.phoneDisplay}</a> : w.phoneDisplay} if
        you run into any issues during your visit.
      </li>
    </ol>
    <figure class="key-photo">
      <img
        src="/img/welcome/key-location.jpg"
        alt="Two labeled keys on the wood shelf by the stairs, tagged 'Prayer Room' and 'Main'"
        loading="lazy"
      />
      <figcaption>The two keys, labeled "Prayer Room" and "Main" — look on the shelf by the stairs.</figcaption>
    </figure>
  </section>

  <section class="section measure container">
    <p class="eyebrow">Before you leave</p>
    <h2>A few reminders</h2>
    <ul class="reminders">
      <li>Help yourself to tea, coffee, and water — leave used mugs in the bin.</li>
      <li>Set the AC/heat unit to a comfortable temperature, but please don't move it.</li>
      <li>When you're done, tidy up and put any trash in the bin.</li>
      <li>
        Unlock both doors, put both keys back on the shelf where you found
        them, and leave the garage's back door unlocked for the next person.
      </li>
    </ul>
    <p>
      Read the full <a href="/visit">visit guide</a> for what to expect inside.
    </p>
    <p>
      This is our first time doing this at scale, and we want it to be a good
      experience — if anything here would have helped you to know sooner,
      or wasn't clear, please <a href="/about#contact">let us know</a>.
    </p>
  </section>
</Base>

<style>
  .notice {
    background: rgba(242, 216, 118, 0.22);
    border-left: 4px solid var(--coral);
    border-radius: var(--radius-sm);
    padding: 1rem 1.1rem; margin-top: 1.4rem;
  }
  .welcome-loc { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 860px) { .welcome-loc { grid-template-columns: 1fr 1fr; } }
  .address {
    font-family: var(--font-head); font-weight: 700; font-size: 1.25rem;
    color: var(--teal-dark); line-height: 1.4;
  }
  .dir-buttons { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1rem; }
  .reminders, .steps { display: grid; gap: 0.8rem; padding-left: 1.2rem; }
  .steps li { padding-left: 0.3rem; }

  .key-photo { margin: 1.4rem 0 0; }
  .key-photo img {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .key-photo figcaption {
    margin-top: 0.6rem; font-size: 0.9rem; color: var(--ink-soft); text-align: center;
  }
</style>
