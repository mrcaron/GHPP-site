---
import Base from '../layouts/Base.astro';
---

<Base title="Thank you" noindex={true}>
  <section class="section center">
    <div class="container measure">
      <div class="ty-mark" aria-hidden="true">🌱</div>
      <h1>Thank you</h1>
      <p class="lede mx-auto">
        Your message is on its way to us. We'll reply by email as soon as we can.
      </p>
      <a href="/" class="btn btn--teal" style="margin-top: 1rem;">Back to home</a>
    </div>
  </section>
</Base>

<style>
  .ty-mark { font-size: 3.5rem; margin-bottom: 0.4rem; }
</style>
